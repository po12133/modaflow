# =============================================================================
# ModaFlow — environment variables
# Copy to .env (never commit .env). In Coolify, set these in the
# application's "Environment Variables" section instead.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (PRIVATE) — used by the postgres and api services only
# Use a URL-safe password (letters/digits), e.g.: openssl rand -hex 32
# -----------------------------------------------------------------------------
POSTGRES_USER=modaflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=modaflow

# -----------------------------------------------------------------------------
# API — NestJS (PRIVATE)
# -----------------------------------------------------------------------------
# Only used when running the API on the host (npm run dev:api) against the
# dockerized database. Inside Docker, compose builds DATABASE_URL itself.
DATABASE_URL=postgresql://modaflow:change_me@localhost:5432/modaflow?schema=public
PORT=3001
# development | staging | production (each compose file sets it; shown in /health)
APP_ENV=development
# Comma-separated allowed origins, or * for any origin.
# Production: https://modaflow.amicornios.com
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /<SWAGGER_PATH>. Disabled by default in production compose.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Public URL of the web app, used in password-reset links.
# Production: https://modaflow.amicornios.com
WEB_APP_URL=http://localhost:3000
# Optional (defaults shown):
# SESSION_TTL_DAYS=30
# COOKIE_SECURE=            # defaults to true when NODE_ENV=production
# TRUST_PROXY=loopback, linklocal, uniquelocal

# -----------------------------------------------------------------------------
# Web — Next.js (PUBLIC: NEXT_PUBLIC_* values are embedded in the browser
# bundle at build time. Never put secrets here.)
# Production: https://api.modaflow.amicornios.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Development compose only (optional)
# -----------------------------------------------------------------------------
# WEB_HOST_PORT=3000
# API_HOST_PORT=3001
# POSTGRES_HOST_PORT=5432
# File polling interval for Next.js hot reload in Docker Desktop (ms)
# WATCH_POLL_INTERVAL_MS=1000
