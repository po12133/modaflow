  passwordHash        String?     @map("password_hash")
  role                StaffRole
  status              StaffStatus @default(ACTIVE)
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            StaffSession[]
  setupTokens         StaffSetupToken[]
  auditLogs           AdminAuditLog[]
  reviewedPayments    PlanChangeRequest[]   @relation("PaymentReviewer")
  subscriptionHistory SubscriptionHistory[]
  subscriptionPeriods SubscriptionPeriod[]
  planVersions        PlanVersion[]
  settingsUpdates     PlatformSettings[]
  integrationUpdates  IntegrationSettings[]

  @@map("staff")
  @@schema("admin")
}

model StaffSession {
  id         String   @id @default(uuid()) @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
  @@schema("admin")
}

model StaffSetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_setup_tokens")
  @@schema("admin")
}
