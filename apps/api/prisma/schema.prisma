// Prisma schema for ModaFlow.
// Docs: https://pris.ly/d/prisma-schema
//
// Multi-tenant model: every business record hangs from a Tenant. Access is
// always resolved from the authenticated user's TenantMembership — never from
// a tenant id sent by the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(120)
  /// Always stored lowercased and trimmed.
  email               String    @unique @db.VarChar(254)
  passwordHash        String    @map("password_hash")
  /// Consecutive failed logins; reset on success. Drives temporary lockout.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         TenantMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  trialGrant          TrialGrant?
  planChangeRequests  PlanChangeRequest[]
  productsCreated     Product[]
  inventoryMovements  InventoryMovement[]
  productImages       ProductImage[]
  aiAnalyses          AiAnalysis[]
  sales               Sale[]               @relation("SaleSeller")
  saleCancellations   SaleCancellation[]   @relation("SaleCanceler")

  @@map("users")
}

/// Server-side session. The cookie holds a random token; only its SHA-256
/// hash is stored, so a database leak does not expose usable sessions.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash") @db.Char(64)
  /// Tenant currently selected in this session (validated against memberships).
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  SELLER
}

/// A business (company) using ModaFlow. Owns stores, subscription and data.
model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(120)
  /// Last product number used to generate SKUs (P00001...). Incremented atomically.
  productSeq Int      @default(0) @map("product_seq")
  /// Last sale number used (V-000001...). Incremented atomically inside the sale transaction.
  saleSeq    Int      @default(0) @map("sale_seq")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         TenantMembership[]
  stores              Store[]
  subscription        Subscription?
  usages              SubscriptionUsage[]
  trialGrant          TrialGrant?
  planChangeRequests  PlanChangeRequest[]
  sessions            Session[]
  categories          Category[]
  tags                Tag[]
  products            Product[]
  productVariants     ProductVariant[]
  productImages       ProductImage[]
  inventoryMovements  InventoryMovement[]
  aiAnalyses          AiAnalysis[]
  sales               Sale[]
  catalogSettings     CatalogSettings[]
  catalogRequests     CatalogOrderRequest[]
  catalogRequestItems CatalogOrderRequestItem[]

  @@map("tenants")
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Store {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(80)
  /// Public identifier for the future online catalog.
  slug         String   @unique @db.VarChar(80)
  description  String?  @db.VarChar(280)
  /// E.164 format, e.g. +59171234567.
  whatsapp     String   @db.VarChar(20)
  city         String   @db.VarChar(80)
  address      String?  @db.VarChar(200)
  /// Hex color, e.g. #6C4CF5.
  primaryColor String   @default("#6C4CF5") @map("primary_color") @db.Char(7)
  /// Pending until durable object storage is configured.
  logoUrl      String?  @map("logo_url") @db.VarChar(500)
  /// IANA time zone used for business days in reports (e.g. America/La_Paz).
  timezone     String   @default("America/La_Paz") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        Product[]
  sales           Sale[]
  catalogSettings CatalogSettings?
  catalogRequests CatalogOrderRequest[]

  @@index([tenantId])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions (limits and features live here, not in code)
// ---------------------------------------------------------------------------

enum BillingPeriod {
  TRIAL
  MONTHLY
}

enum UsagePeriod {
  /// Counted once over the whole subscription (e.g. trial AI analyses).
  TOTAL
  /// Resets every calendar month.
  MONTHLY
}

enum CatalogAccess {
  NONE
  /// Available only while the trial is active.
  TEMPORARY
  FULL
}

model Plan {
  id            String        @id @default(uuid()) @db.Uuid
  /// Stable identifier used by code and seed: gratis | basico | pro | premium.
  code          String        @unique @db.VarChar(32)
  name          String        @db.VarChar(60)
  tagline       String        @db.VarChar(200)
  /// Price in centavos of boliviano (Bs 30 => 3000).
  priceCents    Int           @map("price_cents")
  currency      String        @default("BOB") @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  /// Fixed duration for trial plans (14). Null for recurring plans.
  durationDays  Int?          @map("duration_days")
  isTrial       Boolean       @default(false) @map("is_trial")
  isRecommended Boolean       @default(false) @map("is_recommended")
  isActive      Boolean       @default(true) @map("is_active")
  sortOrder     Int           @map("sort_order")

  maxProducts      Int         @map("max_products")
  aiAnalysesLimit  Int         @map("ai_analyses_limit")
  aiAnalysesPeriod UsagePeriod @map("ai_analyses_period")
  maxUsers         Int         @map("max_users")
  maxBranches      Int         @map("max_branches")

  inventoryAndSales  Boolean       @map("inventory_and_sales")
  advancedReports    Boolean       @map("advanced_reports")
  onlineCatalog      CatalogAccess @map("online_catalog")
  advancedManagement Boolean       @map("advanced_management")

  /// Marketing bullet points shown in plan cards.
  highlights String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions      Subscription[]
  changeRequestsFrom PlanChangeRequest[] @relation("ChangeFromPlan")
  changeRequestsTo   PlanChangeRequest[] @relation("ChangeToPlan")

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

/// Current subscription of a tenant (one per tenant). The effective status is
/// also derived from `currentPeriodEnd`, so an elapsed trial counts as expired
/// even before a job updates `status`.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @unique @map("tenant_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus
  startedAt        DateTime           @map("started_at") @db.Timestamptz(3)
  currentPeriodEnd DateTime           @map("current_period_end") @db.Timestamptz(3)
  canceledAt       DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum UsageMetric {
  AI_ANALYSES
}

/// Metered consumption per tenant and period (products, users and branches are
/// counted live from their own tables instead).
model SubscriptionUsage {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  metric      UsageMetric
  periodStart DateTime    @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime    @map("period_end") @db.Timestamptz(3)
  used        Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@map("subscription_usages")
}

/// Records that a free trial was granted. Unique per user, tenant and business
/// WhatsApp so the trial cannot be restarted by recreating a store.
model TrialGrant {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  whatsappNormalized String   @unique @map("whatsapp_normalized") @db.VarChar(20)
  grantedAt          DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("trial_grants")
}

enum PlanChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

/// Request from a tenant to switch plans. Approval (and payment) is handled
/// later by ModaFlow staff; tenants can never activate a paid plan themselves.
model PlanChangeRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  requestedById String                  @map("requested_by_id") @db.Uuid
  fromPlanId    String                  @map("from_plan_id") @db.Uuid
  toPlanId      String                  @map("to_plan_id") @db.Uuid
  status        PlanChangeRequestStatus @default(PENDING)
  note          String?                 @db.VarChar(500)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User   @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  fromPlan    Plan   @relation("ChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan      Plan   @relation("ChangeToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("plan_change_requests")
}

// ---------------------------------------------------------------------------
// Catalog: categories, tags, products, variants and images (Stage 2)
// ---------------------------------------------------------------------------

/// Per-tenant category. normalizedName (lowercase, no accents, single spaces)
/// prevents duplicates such as "Blusas" and " blusas ".
model Category {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(60)
  normalizedName String   @map("normalized_name") @db.VarChar(60)
  sortOrder      Int      @default(100) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, normalizedName])
  @@map("categories")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(40)
  normalizedName String   @map("normalized_name") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@unique([tenantId, normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "tags_normalized_name_trgm")
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// A garment model. Stock lives in its variants (size/color); totalStock is
/// a denormalized sum maintained in the same transaction as every movement.
/// Only ACTIVE products count towards the plan product limit.
model Product {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  storeId           String        @map("store_id") @db.Uuid
  categoryId        String?       @map("category_id") @db.Uuid
  createdById       String        @map("created_by_id") @db.Uuid
  /// AI analysis whose suggestions were used to fill the form, if any.
  aiAnalysisId      String?       @unique @map("ai_analysis_id") @db.Uuid
  sku               String        @db.VarChar(40)
  name              String        @db.VarChar(120)
  description       String?       @db.VarChar(500)
  garmentType       String?       @map("garment_type") @db.VarChar(60)
  color             String?       @db.VarChar(40)
  secondaryColors   String[]      @map("secondary_colors")
  style             String?       @db.VarChar(60)
  salePrice         Decimal       @map("sale_price") @db.Decimal(12, 2)
  purchasePrice     Decimal?      @map("purchase_price") @db.Decimal(12, 2)
  /// Stock at or below this (and above 0) is low. 0 disables the alert.
  lowStockThreshold Int           @default(2) @map("low_stock_threshold")
  totalStock        Int           @default(0) @map("total_stock")
  status            ProductStatus @default(ACTIVE)
  slug              String        @db.VarChar(140)
  catalogPublished  Boolean       @default(false) @map("catalog_published")
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category            Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy           User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiAnalysis          AiAnalysis?               @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  images              ProductImage[]
  tags                ProductTag[]
  movements           InventoryMovement[]
  saleItems           SaleItem[]
  catalogRequestItems CatalogOrderRequestItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId, catalogPublished, status, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, salePrice])
  @@index([tenantId, categoryId])
  @@index([storeId])
  /// Trigram indexes for case-insensitive contains search (pg_trgm, see migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm")
  @@map("products")
}

/// Sellable unit of a product (e.g. Roja / M) with its own stock.
/// A one-off garment (ropa de fardo) is a single variant without size/color.
model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sku       String   @db.VarChar(48)
  size      String?  @db.VarChar(20)
  color     String?  @db.VarChar(40)
  /// Only changed together with an InventoryMovement row, never directly.
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements           InventoryMovement[]
  saleItems           SaleItem[]
  catalogRequestItems CatalogOrderRequestItem[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([tenantId, stock])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_variants_sku_trgm")
  @@map("product_variants")
}

/// Photo stored in S3-compatible storage; only the object key lives here.
/// productId is null while the photo is uploaded but the product not saved yet.
model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  /// Object key prefix: tenants/TENANT/images/IMAGE (main.webp and thumb.webp)
  storageKey   String   @unique @map("storage_key") @db.VarChar(300)
  contentType  String   @map("content_type") @db.VarChar(40)
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  position     Int      @default(0)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@index([productId, position])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory movements (Stage 2)
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  INITIAL
  STOCK_IN
  MANUAL_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  /// Stage 3: units sold (decrease) and restored when a sale is canceled (increase).
  SALE
  SALE_CANCEL
}

/// Append-only stock ledger. stock_after = stock_before +/- quantity is enforced
/// by a CHECK constraint, and stock never goes below zero.
model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  variantId      String                @map("variant_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  type           InventoryMovementType
  quantity       Int
  stockBefore    Int                   @map("stock_before")
  stockAfter     Int                   @map("stock_after")
  reason         String?               @db.VarChar(200)
  reference      String?               @db.VarChar(80)
  /// Client-generated key so a retried request does not record the movement twice.
  idempotencyKey String?               @map("idempotency_key") @db.VarChar(64)
  /// Sale that produced (SALE) or reverted (SALE_CANCEL) this movement.
  saleId         String?               @map("sale_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale    Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  @@index([saleId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// AI garment analysis (Stage 2)
// ---------------------------------------------------------------------------

enum AiAnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One garment analysis request. A credit is reserved when the analysis
/// starts (PENDING) and refunded if it fails, so concurrent requests can never
/// exceed the plan limit and failed calls cost nothing.
model AiAnalysis {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  idempotencyKey   String           @map("idempotency_key") @db.VarChar(64)
  status           AiAnalysisStatus @default(PENDING)
  imageIds         String[]         @map("image_ids")
  model            String?          @db.VarChar(64)
  /// 1 while the credit is held or consumed; 0 after a refund.
  creditsCharged   Int              @default(0) @map("credits_charged")
  /// Usage window the credit belongs to (SubscriptionUsage.periodStart).
  usagePeriodStart DateTime         @map("usage_period_start") @db.Timestamptz(3)
  inputTokens      Int?             @map("input_tokens")
  outputTokens     Int?             @map("output_tokens")
  result           Json?
  errorCode        String?          @map("error_code") @db.VarChar(60)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("ai_analyses")
}

// ---------------------------------------------------------------------------
// Sales / point of sale (Stage 3)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  QR
  TRANSFER
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// A confirmed sale. Amounts are computed by the backend from current prices
/// (never trusted from the client). `number` is the per-tenant visible number
/// (V-000001), independent from the internal id.
model Sale {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  number           Int
  sellerId         String        @map("seller_id") @db.Uuid
  /// Sum of original prices (unit price x quantity).
  subtotal         Decimal       @db.Decimal(12, 2)
  /// Sum of per-item discounts.
  itemsDiscount    Decimal       @map("items_discount") @db.Decimal(12, 2)
  /// General discount as entered (percent or Bs) and the resulting amount.
  discountType     DiscountType? @map("discount_type")
  discountValue    Decimal?      @map("discount_value") @db.Decimal(12, 2)
  discountAmount   Decimal       @map("discount_amount") @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  /// Total number of units (garments) sold.
  unitCount        Int           @map("unit_count")
  paymentMethod    PaymentMethod @map("payment_method")
  /// The seller explicitly confirmed the payment was received.
  paymentConfirmed Boolean       @map("payment_confirmed")
  amountReceived   Decimal?      @map("amount_received") @db.Decimal(12, 2)
  changeGiven      Decimal?      @map("change_given") @db.Decimal(12, 2)
  status           SaleStatus    @default(COMPLETED)
  idempotencyKey   String        @map("idempotency_key") @db.VarChar(64)
  /// Random capability token for the public receipt link (null = no link / revoked).
  receiptToken     String?       @unique @map("receipt_token") @db.VarChar(64)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  canceledAt       DateTime?     @map("canceled_at") @db.Timestamptz(3)

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  seller          User                  @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  items           SaleItem[]
  cancellation    SaleCancellation?
  movements       InventoryMovement[]
  catalogRequests CatalogOrderRequest[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, paymentMethod, createdAt])
  @@map("sales")
}

/// Sold line with a snapshot of the commercial data at the time of sale, so
/// later edits to the product never change past sales.
model SaleItem {
  id             String        @id @default(uuid()) @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  variantId      String        @map("variant_id") @db.Uuid
  position       Int
  productName    String        @map("product_name") @db.VarChar(120)
  sku            String        @db.VarChar(48)
  size           String?       @db.VarChar(20)
  color          String?       @db.VarChar(40)
  quantity       Int
  /// Original unit price at the time of sale.
  unitPrice      Decimal       @map("unit_price") @db.Decimal(12, 2)
  /// Discount as entered (percent or Bs per unit).
  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(12, 2)
  /// Per-unit discount amount and resulting unit price.
  unitDiscount   Decimal       @map("unit_discount") @db.Decimal(12, 2)
  finalUnitPrice Decimal       @map("final_unit_price") @db.Decimal(12, 2)
  /// finalUnitPrice x quantity.
  lineTotal      Decimal       @map("line_total") @db.Decimal(12, 2)
  /// lineTotal minus this line's share of the general discount (shares add up to sale.total).
  netTotal       Decimal       @map("net_total") @db.Decimal(12, 2)
  /// Purchase cost per unit at the time of sale. Null when the product had no cost registered.
  unitCost       Decimal?      @map("unit_cost") @db.Decimal(12, 2)
  /// Category at the time of sale (snapshot for historical reports).
  categoryId     String?       @map("category_id") @db.Uuid
  categoryName   String?       @map("category_name") @db.VarChar(60)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([tenantId, productId])
  @@index([variantId])
  @@index([tenantId, categoryId])
  @@map("sale_items")
}

/// Controlled cancellation of a sale (never a physical delete). Stock is
/// restored with SALE_CANCEL movements. Money refunds are handled separately.
model SaleCancellation {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @unique @map("sale_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  reason         String   @db.VarChar(200)
  notes          String?  @db.VarChar(500)
  /// Units returned to stock.
  restockedUnits Int      @map("restocked_units")
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User @relation("SaleCanceler", fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("sale_cancellations")
}

// ---------------------------------------------------------------------------
// Stage 5: online catalog
// ---------------------------------------------------------------------------

enum CatalogStatus {
  PUBLISHED
  HIDDEN
}

enum OutOfStockMode {
  SHOW
  HIDE
}

enum CatalogRequestStatus {
  CREATED
  WHATSAPP_OPENED
  ATTENDED
  CANCELED
}

model CatalogSettings {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  storeId        String         @unique @map("store_id") @db.Uuid
  status         CatalogStatus  @default(PUBLISHED)
  secondaryColor String         @default("#FF5C8A") @map("secondary_color") @db.Char(7)
  logoKey        String?        @map("logo_key") @db.VarChar(300)
  coverKey       String?        @map("cover_key") @db.VarChar(300)
  welcomeMessage String?        @map("welcome_message") @db.VarChar(300)
  outOfStock     OutOfStockMode @default(SHOW) @map("out_of_stock")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("catalog_settings")
}

model CatalogOrderRequest {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  storeId          String               @map("store_id") @db.Uuid
  code             String               @db.VarChar(12)
  tokenHash        String               @map("token_hash") @db.Char(64)
  status           CatalogRequestStatus @default(CREATED)
  itemCount        Int                  @map("item_count")
  unitCount        Int                  @map("unit_count")
  total            Decimal              @db.Decimal(12, 2)
  whatsappOpenedAt DateTime?            @map("whatsapp_opened_at") @db.Timestamptz(3)
  statusChangedAt  DateTime?            @map("status_changed_at") @db.Timestamptz(3)
  saleId           String?              @map("sale_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store                     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sale   Sale?                     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items  CatalogOrderRequestItem[]

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([saleId])
  @@map("catalog_order_requests")
}

model CatalogOrderRequestItem {
  id          String  @id @default(uuid()) @db.Uuid
  requestId   String  @map("request_id") @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  position    Int
  productName String  @map("product_name") @db.VarChar(120)
  sku         String  @db.VarChar(48)
  size        String? @db.VarChar(20)
  color       String? @db.VarChar(40)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  request CatalogOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([tenantId, productId])
  @@map("catalog_order_request_items")
}
