# =============================================================================
# ModaFlow — environment variables
# Copy to .env (never commit .env). In Coolify, set these in the
# application's "Environment Variables" section instead.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (PRIVATE) — used by the postgres and api services only
# Use a URL-safe password (letters/digits), e.g.: openssl rand -hex 32
# -----------------------------------------------------------------------------
POSTGRES_USER=modaflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=modaflow

# Restricted database roles (created by the migrations, passwords applied by
# the one-shot "migrate" service). Each API connects with its own role:
#   modaflow_app   -> subscriber API (cannot see the admin schema)
#   modaflow_admin -> admin API (cannot read subscriber passwords)
# Required in staging/production, at least 16 URL-safe characters
# (openssl rand -hex 32). Development compose has local-only defaults.
APP_DB_PASSWORD=change_me_app_role_password
ADMIN_DB_PASSWORD=change_me_admin_role_password

# -----------------------------------------------------------------------------
# API — NestJS (PRIVATE)
# -----------------------------------------------------------------------------
# Only used when running the API on the host (npm run dev:api) against the
# dockerized database. Inside Docker, compose builds DATABASE_URL itself.
DATABASE_URL=postgresql://modaflow:change_me@localhost:5432/modaflow?schema=public
PORT=3001
# development | staging | production (each compose file sets it; shown in /health)
APP_ENV=development
# Comma-separated allowed origins, or * for any origin.
# Production: https://modaflow.amicornios.com
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /<SWAGGER_PATH>. Disabled by default in production compose.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Public URL of the web app, used in password-reset links.
# Production: https://modaflow.amicornios.com
WEB_APP_URL=http://localhost:3000
# Optional (defaults shown):
# SESSION_TTL_DAYS=30
# SCHEDULER_ENABLED=true
# COOKIE_SECURE=            # defaults to true when NODE_ENV=production
# TRUST_PROXY=loopback, linklocal, uniquelocal

# -----------------------------------------------------------------------------
# Secrets saved from the admin panel (PRIVATE, api and admin-api)
# S3, Claude and SMTP can be edited in the admin panel; their secrets are stored
# encrypted with this key. 64 hex characters: openssl rand -hex 32
# Required in staging/production. Never change it once secrets are saved (they
# would become unreadable and must be entered again).
# -----------------------------------------------------------------------------
SETTINGS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email — SMTP defaults (PRIVATE). Values saved in the admin panel take precedence.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ModaFlow

# -----------------------------------------------------------------------------
# Admin system (PRIVATE) — admin-api and admin-web
# Public URL of the admin web; used in staff setup links and as allowed origin.
# Production: https://admin.modaflow.amicornios.com
# -----------------------------------------------------------------------------
ADMIN_WEB_URL=http://localhost:3002
# Admin session: maximum duration in hours and inactivity limit in minutes.
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=60
# Optional:
# ADMIN_API_INTERNAL_URL=http://localhost:3003   # only for admin-web outside Docker

# -----------------------------------------------------------------------------
# Web — Next.js (PUBLIC: NEXT_PUBLIC_* values are embedded in the browser
# bundle at build time. Never put secrets here.)
# Production: https://api.modaflow.amicornios.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Claude API — garment recognition (PRIVATE, api only; never in the web app)
# Without a key the "Analizar con IA" button is disabled and garments are
# registered manually. Get a key at https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Max time per analysis (ms)
# AI_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# S3-compatible storage — product photos (PRIVATE, api only)
# Development compose provides a local S3 service (SeaweedFS) automatically;
# these values override it. In production use AWS S3, Cloudflare R2, MinIO...
# Without bucket/credentials, photo upload is disabled.
# -----------------------------------------------------------------------------
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # empty = AWS S3
# S3_PUBLIC_ENDPOINT=                # only if browsers must use another host for signed URLs
# S3_REGION=us-east-1                # R2: auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=              # empty = automatic (path style only for localhost/IP/service names)
# S3_PUBLIC_URLS=                   # true = public bucket: short direct image URLs (receipts stay signed)
# S3_KEY_PREFIX=modaflow           # folder inside the bucket (empty = bucket root)
# S3_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Development compose only (optional)
# -----------------------------------------------------------------------------
# S3_HOST_PORT=8333
# WEB_HOST_PORT=3000
# API_HOST_PORT=3001
# POSTGRES_HOST_PORT=5432
# File polling interval for Next.js hot reload in Docker Desktop (ms)
# WATCH_POLL_INTERVAL_MS=1000
